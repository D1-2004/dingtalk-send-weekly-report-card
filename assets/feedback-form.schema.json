{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/feedback-form.json",
  "title": "Decoded weekly feedback form",
  "type": "object",
  "required": [
    "fields"
  ],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 9,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "name",
              "hidden",
              "defaultValue"
            ],
            "properties": {
              "name": {
                "enum": [
                  "submissionId",
                  "customer",
                  "week",
                  "collector",
                  "reportTime"
                ]
              },
              "hidden": {
                "const": true
              },
              "defaultValue": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "hidden",
              "defaultValue"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^project_[1-9][0-9]*$"
              },
              "hidden": {
                "const": true
              },
              "defaultValue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "label",
              "type",
              "required",
              "options"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^satisfaction_[1-9][0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "type": {
                "const": "CHECKBOX_GROUP"
              },
              "required": {
                "const": true
              },
              "requiredMsg": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "const": [
                  {
                    "value": "满意",
                    "text": "满意"
                  },
                  {
                    "value": "不满意",
                    "text": "不满意"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "label",
              "type",
              "options"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^reasons_[1-9][0-9]*$"
              },
              "label": {
                "const": "不满意原因（可多选）"
              },
              "type": {
                "const": "MULTI_SELECT"
              },
              "placeholder": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "const": [
                  {"value": "响应不及时", "text": "响应不及时"},
                  {"value": "问题未解决", "text": "问题未解决"},
                  {"value": "交付质量不佳", "text": "交付质量不佳"},
                  {"value": "沟通体验不佳", "text": "沟通体验不佳"},
                  {"value": "需求理解偏差", "text": "需求理解偏差"},
                  {"value": "其他", "text": "其他"}
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "label",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^feedback_[1-9][0-9]*$"
              },
              "label": {
                "const": "具体反馈"
              },
              "type": {
                "const": "TEXT_AREA"
              },
              "placeholder": {
                "type": "string"
              },
              "defaultValue": {
                "const": ""
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
