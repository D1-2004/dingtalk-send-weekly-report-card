{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/weekly-feedback-read-v2.json",
  "title": "WeeklyFeedbackReadPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keyword",
    "schemaVersion",
    "outTrackId",
    "reportUrl",
    "summaryMarkdown",
    "riskMarkdown",
    "nextWeekMarkdown",
    "projects",
    "dissatisfactionOptions",
    "reportPeriod",
    "customer",
    "week",
    "collector",
    "reportTime",
    "isRead"
  ],
  "properties": {
    "keyword": {
      "const": "weekly_report_mark_read"
    },
    "schemaVersion": {
      "const": 2
    },
    "outTrackId": {
      "type": "string",
      "minLength": 1
    },
    "reportUrl": {
      "type": "string",
      "minLength": 1
    },
    "summaryMarkdown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskMarkdown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextWeekMarkdown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dissatisfactionOptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reportPeriod": {
      "type": "string"
    },
    "customer": {
      "type": "string",
      "minLength": 1
    },
    "week": {
      "type": "string",
      "minLength": 1
    },
    "collector": {
      "type": "string",
      "minLength": 1
    },
    "reportTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "isRead": {
      "type": "boolean"
    }
  }
}
