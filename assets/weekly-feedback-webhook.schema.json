{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/weekly-feedback-webhook-v2.json",
  "title": "Weekly feedback webhook payload v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "action",
    "submissionId",
    "reportUrl",
    "reportPeriod",
    "customer",
    "week",
    "projects",
    "satisfaction",
    "dissatisfactionReasons",
    "feedback",
    "collector",
    "reportTime",
    "feedbackUser",
    "feedbackUserId",
    "feedbackUserName"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "action": {
      "const": "submit_weekly_feedback"
    },
    "submissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "reportUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "reportPeriod": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "customer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "week": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "satisfaction": {
      "enum": [
        "满意",
        "不满意"
      ]
    },
    "dissatisfactionReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "feedback": {
      "type": "string",
      "maxLength": 1000
    },
    "collector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reportTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "feedbackUser": {
      "type": "object",
      "required": [
        "userId",
        "name",
        "avatar",
        "corpId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "avatar": {
          "type": "string",
          "maxLength": 2048
        },
        "corpId": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "feedbackUserId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "feedbackUserName": {
      "type": "string",
      "maxLength": 100
    }
  },
  "additionalProperties": false
}
