{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/weekly-feedback-view-v1.json",
  "title": "WeeklyFeedbackViewPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "schemaVersion",
    "submissionId",
    "customer",
    "week",
    "viewTime",
    "respondentId",
    "respondentNickname",
    "viewEnv"
  ],
  "properties": {
    "action": {
      "const": "view_weekly_feedback"
    },
    "schemaVersion": {
      "const": 2
    },
    "submissionId": {
      "type": "string",
      "minLength": 1
    },
    "customer": {
      "type": "string"
    },
    "week": {
      "type": "string"
    },
    "viewTime": {
      "type": "string",
      "format": "date-time"
    },
    "respondentId": {
      "type": "string"
    },
    "respondentNickname": {
      "type": "string"
    },
    "viewEnv": {
      "enum": [
        "dingtalk",
        "anonymous"
      ]
    }
  }
}
