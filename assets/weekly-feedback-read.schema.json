{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/weekly-feedback-read-v2.json",
  "title": "WeeklyFeedbackReadPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyword", "schemaVersion", "outTrackId", "row"],
  "properties": {
    "keyword": { "const": "weekly_report_mark_read" },
    "schemaVersion": { "const": 2 },
    "outTrackId": { "type": "string", "minLength": 1 },
    "row": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "编号", "客户", "项目", "周次", "收集人", "周报链接", "周报周期",
          "周报时间", "数据版本", "本周进展", "风险关注", "下周重点",
          "不满意原因选项", "是否已读"
        ],
        "properties": {
          "编号": { "type": "string", "minLength": 1 },
          "客户": { "type": "string", "minLength": 1 },
          "项目": { "type": "string", "minLength": 1, "contentMediaType": "application/json" },
          "周次": { "type": "string", "minLength": 1 },
          "收集人": { "type": "string", "minLength": 1 },
          "周报链接": { "type": "string", "minLength": 1 },
          "周报周期": { "type": "string" },
          "周报时间": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$" },
          "数据版本": { "const": 2 },
          "本周进展": { "type": "string" },
          "风险关注": { "type": "string" },
          "下周重点": { "type": "string" },
          "不满意原因选项": { "type": "string", "contentMediaType": "application/json" },
          "是否已读": { "const": "是" }
        }
    }
  }
}
