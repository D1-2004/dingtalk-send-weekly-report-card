{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weekly-report-briefing.schema.json",
  "title": "周报简报固定格式",
  "description": "钉钉周报回访的简报统一格式：本周进展 / 风险·关注 / 下周重点。HTML 反馈页与钉钉 Markdown 卡片共用此定义，脚本在生成时引用本文件，确保每次网页结构一致。进展必填；风险、下周重点可选，缺省或空数组时对应块不渲染。每段最多 3 条，单条 ≤ 120 字，文字精炼；细节留给完整周报。",
  "type": "object",
  "properties": {
    "summaryMarkdown": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "riskMarkdown": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "nextWeekMarkdown": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    }
  },
  "required": ["summaryMarkdown"],
  "additionalProperties": false
}
