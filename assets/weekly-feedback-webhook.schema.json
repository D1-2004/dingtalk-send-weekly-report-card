{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/weekly-feedback-webhook-v2.json",
  "title": "WeeklyFeedbackWebhookPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "schemaVersion",
    "submissionId",
    "reportUrl",
    "summaryMarkdown",
    "riskMarkdown",
    "nextWeekMarkdown",
    "projects",
    "satisfaction",
    "dissatisfactionReasons",
    "feedback",
    "dissatisfactionOptions",
    "reportPeriod",
    "customer",
    "week",
    "collector",
    "reportTime",
    "respondentId",
    "respondentNickname",
    "feedbackTime"
  ],
  "properties": {
    "action": {
      "const": "submit_weekly_feedback"
    },
    "schemaVersion": {
      "const": 2
    },
    "submissionId": {
      "type": "string",
      "minLength": 1
    },
    "reportUrl": {
      "type": "string"
    },
    "summaryMarkdown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskMarkdown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextWeekMarkdown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "satisfaction": {
      "enum": [
        "满意",
        "不满意"
      ]
    },
    "dissatisfactionReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feedback": {
      "type": "string"
    },
    "dissatisfactionOptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reportPeriod": {
      "type": "string"
    },
    "customer": {
      "type": "string",
      "minLength": 1
    },
    "week": {
      "type": "string",
      "minLength": 1
    },
    "collector": {
      "type": "string",
      "minLength": 1
    },
    "reportTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "respondentId": {
      "type": "string",
      "minLength": 1
    },
    "respondentNickname": {
      "type": "string",
      "minLength": 1
    },
    "feedbackTime": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "satisfaction": {
            "const": "不满意"
          }
        }
      },
      "then": {
        "properties": {
          "dissatisfactionReasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
